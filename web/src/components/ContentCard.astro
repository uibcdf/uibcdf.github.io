---
interface Props {
  title: string;
  summary: string;
  date: Date;
  tags?: string[];
  href?: string;
}

const { title, summary, date, tags = [], href } = Astro.props;
---

<article class="card card-entry">
  <div class="card-meta">
    <p>{date.toISOString().slice(0, 10)}</p>
    {
      tags.length > 0 && (
        <ul class="tag-list" aria-label="Tags">
          {tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )
    }
  </div>
  <h2>{href ? <a href={href}>{title}</a> : title}</h2>
  <p>{summary}</p>
</article>

<style>
  .card-entry h2 a {
    text-decoration: none;
  }
</style>
